# --- Claude (Intake/Brand/Flyer agents) ---
ANTHROPIC_API_KEY=
ADCLARITY_MODEL=claude-sonnet-5

# --- Higgsfield (optional — AI photo generation, graceful CSS-only fallback if unset) ---
HF_API_KEY=
HF_API_SECRET=

# --- Persistent storage (@upstash/redis) — required for real data persistence and
# the free-tier flyer limit. Get these from the Vercel dashboard: Marketplace ->
# Upstash, or from upstash.com directly (same env var shape either way). ---
# Local dev: use the bridge from `npm run dev:redis` (see docs/local-development.md).
# NEVER put a production upstash.io URL here.
UPSTASH_REDIS_REST_URL=http://127.0.0.1:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# --- Dashboard auth ---
# DASHBOARD_PASSWORD: any real password you'll remember.
# SESSION_SECRET: run `openssl rand -hex 32` and use the output.
DASHBOARD_PASSWORD=
SESSION_SECRET=

# --- Password reset email (Resend) ---
# RESEND_API_KEY: from resend.com or the Vercel Marketplace Resend integration.
# RESEND_FROM_ADDRESS: optional — defaults to Resend's shared onboarding@resend.dev
# sender (no domain verification needed). Once a real domain is verified with
# Resend, set this to something like "OneFlyer <noreply@yourdomain.com>".
RESEND_API_KEY=

# --- Operational alerts ---
# ALERT_EMAIL: where automated alerts go when production is misconfigured —
# currently, production connected to the wrong Redis database, or to an
# unmarked one (see assertRedisMatchesEnvironment in lib/store.ts). This is
# an operator address, not a customer-facing one. If unset, the condition is
# still logged, and the log says explicitly that no email went out.
ALERT_EMAIL=
RESEND_FROM_ADDRESS=

# development | preview | production. Pins the environment for the Redis guardrail.
APP_ENV=development

# --- Site URL ---
# Absolute base for QR redeem links and uploaded-photo URLs (lib/site-url.ts).
# LOCAL DEV: set to http://localhost:3000. Unset, it falls back to the
# production domain, and a locally uploaded photo returns a production URL
# for a blob that only exists in the non-production Blob store.
NEXT_PUBLIC_SITE_URL=

# --- Stripe billing (Basic / Pro self-serve) --------------------------------
# Sandbox keys locally. lib/stripe.ts refuses a live key outside production.
STRIPE_SECRET_KEY=sk_test_...
# Not read by the app: Checkout and the Customer Portal are Stripe-hosted, so no
# browser-side key is needed. Harmless to set; not required in production.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen --print-secret` locally; from the dashboard endpoint in prod.
STRIPE_WEBHOOK_SECRET=whsec_...
# Created by `npm run stripe:setup` (sandbox). Live IDs are set by hand.
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
# Optional — omit to use the account's default portal configuration.
STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
